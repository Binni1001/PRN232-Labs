  "components": {
    "schemas": {
      "CreatePlayerInstrumentRequest": {
        "required": [
          "instrumentTypeId",
          "level",
          "modelName"
        ],
        "type": "object",
        "properties": {
          "instrumentTypeId": {
            "type": "integer",
            "format": "int32"
          },
          "modelName": {
            "minLength": 1,
            "type": "string"
          },
          "level": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "CreatePlayerRequest": {
        "required": [
          "nickName",
          "playerInstruments"
        ],
        "type": "object",
        "properties": {
          "nickName": {
            "minLength": 1,
            "type": "string"
          },
          "playerInstruments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CreatePlayerInstrumentRequest"
            }
          }
        },
        "additionalProperties": false
      },
      "UpdatePlayerRequest": {
        "required": [
          "nickName"
        ],
        "type": "object",
        "properties": {
          "nickName": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "WeatherForecast": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "temperatureC": {
            "type": "integer",
            "format": "int32"
          },
          "temperatureF": {
            "type": "integer",
            "format": "int32",
            "readOnly": true
          },
          "summary": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    }
  }
