@page
@model ProductManagementRazorPages.Pages.Cosmetics.IndexModel

<h2>Cosmetics</h2>

<form method="get" class="mb-3">
    <input asp-for="SearchName" class="form-control" placeholder="Search cosmetic name..." />
    <button class="btn btn-primary mt-2">Search</button>
</form>

@if (Model.Role == "1")
{
    <a asp-page="Create" class="btn btn-success mb-3">Create New</a>
}

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Name</th>
            <th>Skin Type</th>
            <th>Size</th>
            <th>Price</th>
            <th>Expiration</th>
            <th>Category</th>
            <th>Action</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model.Cosmetics)
        {
            <tr>
                <td>@item.CosmeticName</td>
                <td>@item.SkinType</td>
                <td>@item.CosmeticSize</td>
                <td>@item.DollarPrice</td>
                <td>@item.ExpirationDate</td>
                <td>@item.Category?.CategoryName</td>
                <td>
                    <a asp-page="Details" asp-route-id="@item.CosmeticId">Details</a>

                    @if (Model.Role == "1")
                    {
                        <span> | </span>
                        <a asp-page="Edit" asp-route-id="@item.CosmeticId">Edit</a>
                        <span> | </span>
                        <a asp-page="Delete" asp-route-id="@item.CosmeticId">Delete</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>