@page "{id}"
@model ProductManagementRazorPages.Pages.Cosmetics.DetailsModel

<h2>Cosmetic Details</h2>

@if (Model.Cosmetic != null)
{
    <dl class="row">
        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@Model.Cosmetic.CosmeticName</dd>

        <dt class="col-sm-2">Skin Type</dt>
        <dd class="col-sm-10">@Model.Cosmetic.SkinType</dd>

        <dt class="col-sm-2">Size</dt>
        <dd class="col-sm-10">@Model.Cosmetic.CosmeticSize</dd>

        <dt class="col-sm-2">Price</dt>
        <dd class="col-sm-10">@Model.Cosmetic.DollarPrice</dd>

        <dt class="col-sm-2">Expiration</dt>
        <dd class="col-sm-10">@Model.Cosmetic.ExpirationDate</dd>

        <dt class="col-sm-2">Category</dt>
        <dd class="col-sm-10">@Model.Cosmetic.Category?.CategoryName</dd>
    </dl>
}

<a asp-page="Index" class="btn btn-secondary">Back</a>