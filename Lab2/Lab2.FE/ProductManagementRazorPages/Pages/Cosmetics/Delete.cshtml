@page "{id}"
@model ProductManagementRazorPages.Pages.Cosmetics.DeleteModel

<h2>Delete Cosmetic</h2>

@if (Model.Cosmetic != null)
{
    <p>Are you sure you want to delete this cosmetic?</p>

    <dl class="row">
        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@Model.Cosmetic.CosmeticName</dd>

        <dt class="col-sm-2">Skin Type</dt>
        <dd class="col-sm-10">@Model.Cosmetic.SkinType</dd>

        <dt class="col-sm-2">Price</dt>
        <dd class="col-sm-10">@Model.Cosmetic.DollarPrice</dd>
    </dl>

    <form method="post">
        <input type="hidden" asp-for="Cosmetic.CosmeticId" />
        <button class="btn btn-danger">Delete</button>
        <a asp-page="Index" class="btn btn-secondary">Cancel</a>
    </form>
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <p class="text-danger mt-3">@Model.ErrorMessage</p>
}